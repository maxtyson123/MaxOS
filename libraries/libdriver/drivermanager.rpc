package drivermanager;
version 1.0;
path /server/
include <libdriver/hardwarecommunication/mapping.h>;
include <libdriver/device.h>;

service drivermanager {

    rpc void driver_ready(string id)

    rpc LibDriver::HardwareCommunication::hardware_mapping_t get_hardware_mapping(string id)
    rpc LibDriver::device_identification_t get_device_identification(string id)

    rpc int register_device(LibDriver::HardwareCommunication::hardware_mapping_t hmap,LibDriver::device_identification_t did)

}
